# Salin jadi .env lalu isi nilainya. JANGAN commit .env yang sudah terisi.
#
# Ambil dari Firebase Console > Project Settings > General > Your apps >
# SDK setup and configuration > Config.
#
# PENTING: nilai `apiKey` ini BUKAN rahasia. Firebase merancangkannya untuk
# terlihat publik di frontend. Yang melindungi data adalah Security Rules
# (firebase/firestore.rules). Jangan pernah menaruh private key / service
# account JSON di sini.

EXPO_PUBLIC_FIREBASE_API_KEY=AIza...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=nama-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=nama-project
EXPO_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Kode admin untuk /admin/guestbook (opsional).
#
# Peringatan: variabel EXPO_PUBLIC_* di-inline ke bundel JS saat build,
# jadi nilai ini BUKAN rahasia dan bisa dibaca siapa pun lewat DevTools.
# Nilainya juga harus sama dengan password akun admin di Firebase
# Authentication.
#
# Kalau dikosongkan, aplikasi memakai kode yang diketik pengguna dan
# diverifikasi langsung oleh Firebase Auth — mode itu yang lebih aman.
EXPO_PUBLIC_ADMIN_PASSCODE=aradhana miftah hermawan